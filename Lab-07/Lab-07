7. PRIMARY KEY CONSTRAINTS (UNIQUE AND NOT NULL)

postgres=# CREATE TABLE lab07_departments (
postgres(#     dept_id INTEGER PRIMARY KEY,
postgres(#     dept_name VARCHAR(100)
postgres(# );
EXPECTED OUTPUT: CREATE TABLE

postgres=# INSERT INTO lab07_departments VALUES
postgres-# (1, 'Software Engineering'),
postgres-# (2, 'Computer Science'),
postgres-# (3, 'Mathematics');
EXPECTED OUTPUT: INSERT 0 3

postgres=# SELECT * FROM lab07_departments ORDER BY dept_id;
EXPECTED OUTPUT:
 dept_id |      dept_name
---------+----------------------
       1 | Software Engineering
       2 | Computer Science
       3 | Mathematics
(3 rows)

postgres=# INSERT INTO lab07_departments VALUES (1, 'Physics');
EXPECTED ERROR: duplicate key value violates unique constraint "lab07_departments_pkey"
DETAIL: Key (dept_id)=(1) already exists.

postgres=# INSERT INTO lab07_departments VALUES (NULL, 'Physics');
EXPECTED ERROR: null value in column "dept_id" of relation "lab07_departments" violates not-null constraint

NOTE: Both errors above are intentional demonstrations of primary-key enforcement. PostgreSQL wording may differ by version.

