-- 1. PRIMARY KEY: COLUMN-LEVEL CONSTRAINT

CREATE TABLE students (
    student_id INTEGER PRIMARY KEY,
    name VARCHAR(100),
    email VARCHAR(150)
);


-- 2. PRIMARY KEY: TABLE-LEVEL CONSTRAINT

CREATE TABLE students_table_level (
    student_id INTEGER,
    name VARCHAR(100),
    email VARCHAR(150),
    PRIMARY KEY (student_id)
);


-- 3. PRIMARY KEY: NAMED CONSTRAINT

CREATE TABLE students_named (
    student_id INTEGER,
    name VARCHAR(100),
    email VARCHAR(150),
    CONSTRAINT pk_students_named PRIMARY KEY (student_id)
);


-- 4. ADD PRIMARY KEY TO AN EXISTING TABLE

CREATE TABLE employees (
    employee_id INTEGER,
    employee_name VARCHAR(100),
    department VARCHAR(100)
);

ALTER TABLE employees
ADD CONSTRAINT pk_employees PRIMARY KEY (employee_id);


-- 5. SINGLE PRIMARY KEY WITH SERIAL

CREATE TABLE university_students (
    student_id SERIAL PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    email VARCHAR(150) UNIQUE,
    faculty VARCHAR(50)
);

INSERT INTO university_students (name, email, faculty)
VALUES
    ('Alice Johnson', 'alice@alatoo.edu.kg', 'Computer Science'),
    ('Bob Smith', 'bob@alatoo.edu.kg', 'Mathematics'),
    ('Carol Davis', 'carol@alatoo.edu.kg', 'Computer Science');

SELECT * FROM university_students;


-- 6. COMPOSITE PRIMARY KEY

CREATE TABLE course_enrollments (
    student_id INTEGER,
    course_id INTEGER,
    semester VARCHAR(20),
    enrollment_date DATE DEFAULT CURRENT_DATE,
    grade CHAR(2),
    PRIMARY KEY (student_id, course_id, semester)
);

INSERT INTO course_enrollments
    (student_id, course_id, semester, grade)
VALUES
    (1, 101, '2024-Spring', 'A'),
    (1, 102, '2024-Spring', 'B+'),
    (2, 101, '2024-Spring', 'A-'),
    (1, 101, '2024-Fall', 'A+');

SELECT * FROM course_enrollments;


-- 7. AUTO-INCREMENT USING SERIAL

CREATE TABLE products (
    product_id SERIAL PRIMARY KEY,
    product_name VARCHAR(100) NOT NULL,
    price DECIMAL(10,2)
);

INSERT INTO products (product_name, price)
VALUES
    ('Laptop', 1200.00),
    ('Mouse', 25.50),
    ('Keyboard', 75.00);

SELECT * FROM products;


-- 8. AUTO-INCREMENT USING BIGSERIAL

CREATE TABLE transactions (
    transaction_id BIGSERIAL PRIMARY KEY,
    amount DECIMAL(15,2),
    transaction_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

INSERT INTO transactions (amount)
VALUES
    (250.00),
    (500.75),
    (1000.00);

SELECT * FROM transactions;


-- 9. IDENTITY ALWAYS

CREATE TABLE orders (
    order_id INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    customer_name VARCHAR(100),
    order_date DATE DEFAULT CURRENT_DATE
);

INSERT INTO orders (customer_name)
VALUES
    ('Alice Johnson'),
    ('Bob Smith');

SELECT * FROM orders;


-- 10. IDENTITY BY DEFAULT

CREATE TABLE customers (
    customer_id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    customer_name VARCHAR(100),
    email VARCHAR(150)
);

INSERT INTO customers (customer_id, customer_name, email)
VALUES
    (1000, 'VIP Customer', 'vip@example.com');

INSERT INTO customers (customer_name, email)
VALUES
    ('Regular Customer', 'regular@example.com');

SELECT * FROM customers;


-- 11. PRIMARY KEY CONSTRAINTS

CREATE TABLE departments (
    dept_id INTEGER PRIMARY KEY,
    dept_name VARCHAR(100)
);

INSERT INTO departments
VALUES
    (1, 'Computer Science'),
    (2, 'Mathematics'),
    (3, 'Physics');

SELECT * FROM departments;


