-- 14. CHECK PRIMARY KEY INDEXES

SELECT
    tablename,
    indexname,
    indexdef
FROM pg_indexes
WHERE schemaname = 'public'
  AND tablename IN (
      'students',
      'students_table_level',
      'students_named',
      'employees',
      'university_students',
      'course_enrollments',
      'products',
      'transactions',
      'orders',
      'customers',
      'departments'
  )
ORDER BY tablename, indexname;
